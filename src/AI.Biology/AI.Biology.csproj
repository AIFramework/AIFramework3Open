<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>12.0</LangVersion>
    <RootNamespace>AI.Biology</RootNamespace>
    <AssemblyName>AI.Biology</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Величины, статистические критерии и контракт объяснимости -->
    <ProjectReference Include="..\AI\AI.csproj" />
    <!-- Интегрирование систем ОДУ: модели популяций и эпидемий -->
    <ProjectReference Include="..\AI.ClassicMath\AI.ClassicMath.csproj" />
    <!-- Трёхмерные векторы: координаты атомов белка -->
    <ProjectReference Include="..\AI.Geometry\AI.Geometry.csproj" />
    <!-- Чтение PDB, торсионные углы, совмещение по Кабшу, стохастическая кинетика -->
    <ProjectReference Include="..\AI.Solvers.Chem\AI.Solvers.Chem.csproj" />
    <!-- Симплекс: балансовый анализ метаболических потоков -->
    <ProjectReference Include="..\AI.Solvers.Optimization\AI.Solvers.Optimization.csproj" />
  </ItemGroup>

</Project>
