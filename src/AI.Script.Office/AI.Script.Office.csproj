<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>12.0</LangVersion>
    <RootNamespace>AI.Script.Office</RootNamespace>
    <AssemblyName>AI.Script.Office</AssemblyName>
  </PropertyGroup>

  <!-- Отдельная сборка от AI.Script.Std по весу зависимостей, как Nn и Vision: книги Excel,
       документы Word и PDF тянут три чужих пакета, а скрипту, которому нужны только таблицы и
       статистика, платить за них ни размером поставки, ни временем запуска незачем. -->
  <ItemGroup>
    <!-- Версии те же, что у исполнителей MASAgents. OpenXml 3.x тянет System.IO.Packaging 8.0.1+, где
         исправлены CVE-2024-43483 и CVE-2024-43484 версии 6.0.0 из OpenXml 2.x: отдельной ссылки не нужно. -->
    <PackageReference Include="ClosedXML" Version="0.104.2" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="PdfPig" Version="0.1.15" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AI\AI.csproj" />
    <ProjectReference Include="..\AI.Script\AI.Script.csproj" />
    <!-- Стандартная библиотека нужна ради разбора человеческой записи чисел и морфологии:
         счёт по документу обязан понимать «1 234,50 ₽» и словоформы так же, как таблицы. -->
    <ProjectReference Include="..\AI.Script.Std\AI.Script.Std.csproj" />
  </ItemGroup>

</Project>
