# Прикладные пространства: экономика, СВЧ и химия в одном конвейере.
# Задача: линия СВЧ-сушки древесины — посчитать физику, экономику и расход реагента.
# Запускается тестом AI.Script.UnitTests.ExamplesTests.

options {
    seed: 5
}

# --- 1. СВЧ: что физически возможно ---

let частота = 2.45e9
let древесина = mw.material("древесина")

emit длина_волны_мм = core.round(mw.wavelength(частота) * 1000, digits: 1)

let глубина = mw.penetration(
    frequency: частота,
    permittivity: древесина.permittivity,
    loss_factor: древесина.loss_factor)

emit глубина_проникновения_мм = core.round(глубина * 1000, digits: 1)

# Толщину доски выбираем не по желанию, а по равномерности прогрева: именно она,
# а не КПД, ограничивает то, что можно просушить.

let толщина = mw.max_thickness(penetration: глубина, allowed: 2)

emit толщина_доски_мм = core.round(толщина * 1000, digits: 1)

assert mw.uniformity(thickness: толщина, penetration: глубина) <= 2.01,
    "выбранная толщина обязана укладываться в заданную неравномерность"

# Волновод под эту частоту подбирается сам; проверяем, что режим одномодовый.

let волновод = mw.waveguide(частота)

emit волновод = волновод.standard
emit критическая_ггц = core.round(волновод.cutoff / 1e9, digits: 3)

assert волновод.single_mode, "работать вне одномодового режима нельзя"

# --- 2. Производительность линии ---

let мощность = 60000
let производительность = mw.throughput(
    power: мощность,
    delta: 60,
    heat_capacity: древесина.heat_capacity,
    coupling: 0.7)

emit кг_в_час = core.round(производительность, digits: 0)

# --- 3. Экономика: окупится ли ---

let часов_в_год = 2500
let тонн_в_год = производительность * часов_в_год / 1000

let маржа_на_тонну = 1500
let выручка = тонн_в_год * маржа_на_тонну

# Электроэнергия по подведённой мощности плюс обслуживание: без них проект выглядел бы
# вдвое выгоднее, чем есть.

let киловатт_часов = мощность / 1000 * часов_в_год
let электричество = киловатт_часов * 7
let обслуживание = электричество + 1000000

let вложения = 9000000
let поток = vec.of(range(7) |> core.map(i =>
    if i == 0 { 0 - вложения } else { выручка - обслуживание }))

let оценка = econ.appraise(поток, rate: 0.15)

emit тонн_в_год = core.round(тонн_в_год, digits: 1)
emit npv = core.round(оценка.npv, digits: 0)
emit irr = core.round(оценка.irr, digits: 3)
emit окупаемость_лет = core.round(оценка.payback, digits: 2)
emit принимается = оценка.accepted

# Кредит на оборудование: переплата — часть той же картины, а не отдельный разговор.

let кредит = econ.loan(principal: вложения, rate: 0.19, periods: 36)

emit платёж_в_месяц = core.round(кредит.payment[0], digits: 0)
emit переплата = core.round(кредит.overpayment, digits: 3)

# --- 4. Химия: расход антисептика на партию ---
#
# Расчёт по формуле, а не «по памяти»: молярная масса берётся из таблицы элементов,
# и ошибиться в ней нельзя.

let антисептик = chem.formula("Na2B4O7·10H2O")

emit антисептик_масса = core.round(антисептик.mass, digits: 2)

let раствор_процентов = 3
let раствора_на_тонну = 40
let расход_кг_в_год = тонн_в_год * раствора_на_тонну * раствор_процентов / 100

emit расход_антисептика_кг = core.round(расход_кг_в_год, digits: 0)

let моль_в_год = расход_кг_в_год * 1000 / антисептик.mass

emit молей_в_год = core.round(моль_в_год, digits: 0)

# --- 5. Что показать ---

show table.of({
    показатель: ["Толщина доски, мм", "Производительность, кг/ч", "Тонн в год", "NPV, руб"],
    значение: <
        core.round(толщина * 1000, digits: 1),
        core.round(производительность, digits: 0),
        core.round(тонн_в_год, digits: 1),
        core.round(оценка.npv, digits: 0)
    >
})
