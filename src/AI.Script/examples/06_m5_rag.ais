# Приёмка этапа M5: поиск по корпусу и ответ модели по найденному.
# Скрипт исполняется и без сети: индекс словесный, а обращение к модели — по наличию.
# Запускается тестом AI.Script.UnitTests.ExamplesTests.

options {
    seed: 3
}

# --- корпус ---
#
# Здесь он задан прямо в тексте, чтобы пример не зависел от файлов; в жизни его читают
# из io.read_csv либо получают стадией конвейера.

let документы = [
    "Прокси настраивается в разделе «Сеть»: адрес, порт и, при необходимости, логин с паролем.",
    "Таймаут запроса задаётся в секундах; по умолчанию тридцать, для длинных ответов увеличьте.",
    "Модель выбирается по имени; список доступных имён отдаёт метод models текущего провайдера.",
    "Ключ доступа хранится в переменной окружения и в текст скрипта не попадает.",
    "Кэш ответов включается флагом; повторный запрос с тем же промптом берётся из кэша.",
    "Матрица признаков строится из таблицы: числовые колонки как есть, категории — one-hot.",
]

# --- индекс ---
#
# Словесный (BM25): он не требует ни ключей, ни сети. Семантический строится тем же
# search.of с kind: "semantic", когда хост подключил эмбеддер.

let индекс = search.of(документы, kind: "words")

emit вид_индекса = индекс.kind()
emit документов = индекс.size()

# --- поиск ---

let вопрос = "как настроить прокси"
let найдено = индекс.query(вопрос, top: 3)

emit найдено_строк = len(найдено)
emit лучший = найдено[0].doc

assert найдено[0].doc == 0, "запрос про прокси обязан находить документ про прокси"
assert найдено[0].score >= найдено[1].score, "выдача обязана идти по убыванию оценки"

# --- контекст для промпта ---

let фон = индекс.context(вопрос, top: 2)

emit длина_контекста = len(фон)

assert str.contains(фон, "Прокси"), "в контекст обязан попасть найденный документ"

# --- ответ модели, если она подключена этому прогону ---
#
# Проверка наличия, а не try/catch: спросить заранее дешевле, чем ловить отказ и
# разбирать по тексту, чего именно не хватило — ключа, сети или разрешения.

let ответ = if llm.available() {
    llm.ask(
        """
        Ответь на вопрос пользователя, опираясь только на приведённые фрагменты.
        Если ответа в них нет — так и скажи.

        Фрагменты:
        ${фон}

        Вопрос: ${вопрос}
        """,
        system: "Ты отвечаешь коротко и по делу.")
} else {
    "модель этому прогону недоступна"
}

emit ответ = ответ

# --- расход ---
#
# Виден скрипту, а не только хосту: конвейер, решающий, делать ли ещё проход по модели,
# должен видеть остаток, иначе решение примет потолок — отказом посреди работы.

let расход = llm.usage()

emit вызовов_к_модели = расход.calls

show table.head(найдено, n: 3)
