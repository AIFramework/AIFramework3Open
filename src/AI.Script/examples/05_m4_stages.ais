# Приёмка этапа M4: конвейер из стадий с кэшем, повторами и параллельным участком.
# Скрипт самодостаточен: данные порождаются здесь же.
# Запускается тестом AI.Script.UnitTests.ExamplesTests.

options {
    seed: 11
    parallel: 4
}

# --- стадии конвейера ---
#
# Стадия видит только свои параметры: внешние let ей недоступны, и это не ограничение
# ради строгости, а условие кэшируемости. Результат, зависящий от того, что лежало
# снаружи в момент вызова, кэшировать было бы нельзя.

#| Сырые наблюдения: два признака и метка.
@cache
stage наблюдения(n: num) -> table {
    let x = signal.noise(n, sigma: 1)
    let y = signal.noise(n, sigma: 1)
    let сумма = x + y

    table.of({
        x: x,
        y: y,
        класс: vec.of(range(n) |> core.map(i => if сумма[i] > 0 { 1 } else { 0 }))
    })
}

#| Матрица признаков, нормированная по себе же.
@cache
stage признаки(t: table) -> mat {
    t
    |> table.select(["x", "y"])
    |> table.to_matrix()
    |> mat.zscore()
}

#| Качество модели на отложенной выборке.
@cache
@retry(2)
@timeout(30s)
stage качество(features: mat, labels: vec) -> record {
    let split = ml.split(features, labels, test: 0.3)
    let model = ml.knn(split.x_train, split.y_train, k: 5)

    {
        точность: model.score(split.x_test, split.y_test),
        обучающих: mat.rows(split.x_train),
        проверочных: mat.rows(split.x_test)
    }
}

# --- сам конвейер: композиция стадий через |> ---

let данные = наблюдения(600)
let X = признаки(данные)
let оценка = качество(X, данные["класс"])

emit точность = core.round(оценка.точность, digits: 3)
emit обучающих = оценка.обучающих
emit проверочных = оценка.проверочных

assert оценка.точность > 0.8, "kNN на линейно разделимых данных обязан справляться"

# --- повторный вызов с теми же аргументами тело не выполняет ---

let X2 = признаки(данные)

emit признаки_совпали = math.approx(mat.rows(X), mat.rows(X2), eps: 0.5)

# --- параллельный участок ---
#
# Единственная форма параллелизма в языке. Порядок результата сохраняется, а каждая
# ветвь получает свой поток случайных чисел, выведенный из зерна прогона и номера
# элемента, — поэтому ответ воспроизводим.

fn оценить(k: num) -> num {
    let split = ml.split(X, данные["класс"], test: 0.3)
    let model = ml.knn(split.x_train, split.y_train, k: k)

    model.score(split.x_test, split.y_test)
}

let k = [1, 3, 5, 7, 9, 11, 15, 21]
let точности = k |> core.map(оценить, parallel: true)

emit проверено_k = len(точности)
emit лучшее_k = k[vec.argmax(vec.of(точности))]

show plot.line(vec.of(точности), x: vec.of(k),
    title: "Точность по числу соседей", xlabel: "k", ylabel: "доля верных")
