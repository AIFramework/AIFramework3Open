# Эконометрика: от наивной регрессии к причинному эффекту.
# Задача: сеть из 40 магазинов подключала программу лояльности не везде и не сразу —
# оценить, сколько программа на самом деле добавила к выручке.
# Запускается тестом AI.Script.UnitTests.ExamplesTests.

options {
    seed: 11
}

# --- 1. Данные: 40 магазинов за 12 месяцев ---
# Первые 20 магазинов подключаются к программе в разные месяцы, остальные — никогда.
# У каждого магазина своя «сила», и сильные шли в программу охотнее: именно это
# смешивание и ломает наивное сравнение. Настоящий эффект программы заложен равным 3.

let n = 480
let магазин = vec.of(range(n) |> core.map(i => math.floor(i / 12)))
let месяц = vec.of(range(n) |> core.map(i => (i % 12) + 1))
let старт = vec.of(range(n) |> core.map(i => if магазин[i] < 20 { 4 + (магазин[i] % 3) * 2 } else { 0 }))
let действует = vec.of(range(n) |> core.map(i => if старт[i] > 0 { if месяц[i] >= старт[i] { 1 } else { 0 } } else { 0 }))

let сила = signal.noise(40, sigma: 1)
let уровень = vec.of(range(n) |> core.map(i => сила[магазин[i]] + (if магазин[i] < 20 { 1.5 } else { 0 })))
let выручка = 100 + 5 * уровень + 0.8 * месяц + 3 * действует + signal.noise(n, sigma: 1)

let продажи = table.of({
    магазин: магазин,
    месяц: месяц,
    старт: старт,
    действует: действует,
    выручка: выручка
})

# --- 2. Наивный ответ: регрессия выручки на участие ---
# Ошибки кластеризованы по магазинам: месяцы одного магазина не независимы, и без
# этого p-значение вышло бы слишком оптимистичным.

let наивно = regress.ols(продажи, "выручка", ["действует", "месяц"], cluster: "магазин")

emit наивный_эффект = core.round(наивно.coefficients[1].estimate, digits: 2)

# Коэффициент завышен: в программу шли сильные магазины, и регрессия приписала их
# силу программе. Сама регрессия этого не видит — ошибка в данных, а не в формуле.

# --- 3. Панель: постоянная сила магазина вычитается ---

let панель = regress.panel(продажи, "выручка", ["действует", "месяц"], "магазин", "месяц")
let строка = панель.coefficients |> table.filter(c => c.name == "действует")

emit эффект_панели = core.round(строка[0].estimate, digits: 2)

# --- 4. Разность разностей: подключение в разные месяцы ---
# Здесь эффект одинаков для всех магазинов, и классическая двусторонняя оценка
# совпадает с устойчивой att — estimator_gap около нуля. Разойдутся они, когда эффект
# растёт со временем: тогда классическая при ступенчатом старте смешивает эффекты с
# отрицательными весами. pre_trend_p проверяет главное допущение: до программы
# магазины двигались параллельно.

let разность = causal.did(
    продажи,
    unit: "магазин",
    period: "месяц",
    outcome: "выручка",
    first_treated: "старт",
    bootstrap: 100)

emit эффект_did = core.round(разность.att, digits: 2)
emit ошибка_did = core.round(разность.std_error, digits: 2)
emit предтренд_p = core.round(разность.pre_trend_p, digits: 3)
emit расхождение_оценок = core.round(разность.estimator_gap, digits: 2)

# Разбор библиотеки приходит вместе с числами: summary — вывод одной фразой,
# warnings — нарушенные допущения, из-за которых числам верить нельзя.

emit вывод = разность.summary
emit предупреждения = разность.warnings
