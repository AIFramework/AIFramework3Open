# Изображения и нейросеть в одном конвейере: распознавание направления полос.
# Задача: по картинке понять, вертикальные на ней полосы или горизонтальные.
# Скрипт самодостаточен — образцы рисуются здесь же.
# Запускается тестом AI.Script.UnitTests.ExamplesTests.

options {
    seed: 21
}

# --- 1. Образцы ---
#
# Изображение в языке — обычная матрица яркостей: её печатают, режут, нормируют и рисуют
# тепловой картой теми же функциями, что и любую другую матрицу.

let сторона = 24

fn полоски(вертикально: bool, период: num, сдвиг: num) -> mat {
    mat.of(range(сторона) |> core.map(r =>
        vec.of(range(сторона) |> core.map(c => {
            let координата = if вертикально { c } else { r }

            if ((координата + сдвиг) % период) < (период / 2) { 40 } else { 215 }
        }))))
}

let образцов = 40

let картинки = range(образцов) |> core.map(i =>
    полоски(i % 2 == 0, period(i), i % 5))

fn period(i: num) -> num { 4 + (2 * (i % 3)) }

emit образцов = len(картинки)
emit размер = mat.rows(картинки[0])

# --- 2. Признаки ---
#
# Гистограмма направленных градиентов: она отвечает ровно на тот вопрос, который задан, —
# куда смотрят границы. Подавать сети сырые пиксели тоже можно, но тогда ей пришлось бы
# выучить понятие «граница» самой, а образцов на это здесь нет.

let признаки = mat.from_rows(картинки |> core.map(img => cv.hog(img, bins: 8)))
let метки = vec.of(range(образцов) |> core.map(i => if i % 2 == 0 { 1 } else { 0 }))

emit признаков = mat.cols(признаки)

assert math.approx(mat.rows(признаки), образцов, eps: 0.5), "по строке признаков на каждую картинку"

# --- 3. Обучение ---
#
# Признаки нормируются заранее и параметрами обучающей выборки: prep запоминает их,
# а сеть про нормировку ничего не знает — и правильно, иначе тест нормировался бы иначе.

let разбиение = ml.split(признаки, метки, test: 0.3)
let шкала = prep.zscore(разбиение.x_train)

let сеть = nn.fit(
    шкала.apply(разбиение.x_train),
    разбиение.y_train,
    hidden: [12],
    epochs: 200,
    lr: 0.05,
    batch: 0)

emit параметров = сеть.describe().parameters
emit обучающих = mat.rows(разбиение.x_train)

# --- 4. Качество ---

let точность_обучения = сеть.score(шкала.apply(разбиение.x_train), разбиение.y_train)
let точность_теста = сеть.score(шкала.apply(разбиение.x_test), разбиение.y_test)

emit точность_обучения = core.round(точность_обучения, digits: 3)
emit точность_теста = core.round(точность_теста, digits: 3)

assert точность_теста > 0.8, "направление полос обязано распознаваться"

# Кривая потерь — то, по чему видно, обучилась сеть или только сделала вид.

let потери = сеть.history()

emit потери_в_конце = core.round(потери[len(потери) - 1], digits: 4)

assert потери[len(потери) - 1] < потери[0], "функция потерь обязана убывать"

# --- 5. Что показать ---

show plot.grid([
    plot.line(потери, title: "Функция потерь по эпохам", xlabel: "эпоха"),
    plot.heatmap(картинки[0], title: "Образец: вертикальные полосы"),
    plot.heatmap(cv.sobel(картинки[0]).edges, title: "Границы оператором Собеля")
], title: "Распознавание направления полос")
