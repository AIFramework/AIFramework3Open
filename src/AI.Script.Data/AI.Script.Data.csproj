<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>12.0</LangVersion>
    <RootNamespace>AI.Script.Data</RootNamespace>
    <AssemblyName>AI.Script.Data</AssemblyName>
  </PropertyGroup>

  <!-- Колоночные файлы и локальные базы только на чтение. Отдельно от Std по весу зависимостей:
       Parquet.Net и нативный SQLite нужны не каждому хосту. Версии те же, что у редактора таблиц
       в MASAgents, иначе сборка продукта получит понижение пакета (NU1605). -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.10" />
    <PackageReference Include="Parquet.Net" Version="6.1.0" />
    <!-- Нативная библиотека SQLite явно: транзитивно приезжает 2.1.11 с известной уязвимостью
         (GHSA-2m69-gcr7-jv3q), а скрипт открывает базы, которые прислал пользователь. -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AI.Script\AI.Script.csproj" />
    <ProjectReference Include="..\AI.Script.Std\AI.Script.Std.csproj" />
  </ItemGroup>

</Project>
