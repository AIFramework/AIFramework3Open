    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>12.0</LangVersion>
    <RootNamespace>AI.Script.Science</RootNamespace>
    <AssemblyName>AI.Script.Science</AssemblyName>
  </PropertyGroup>

  <!-- Естественные науки отдельным пакетом, как и химия: ядру языка незачем тянуть физику и
