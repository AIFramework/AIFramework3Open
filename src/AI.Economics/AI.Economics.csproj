<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>AI.Economics</RootNamespace>
    <AssemblyName>AI.Economics</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AI\AI.csproj" />
    <!-- Предсказание банкротства строится на классификаторах фреймворка -->
    <ProjectReference Include="..\AI.ML\AI.ML.csproj" />
  </ItemGroup>

</Project>
