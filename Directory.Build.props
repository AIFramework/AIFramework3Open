<Project>
  <PropertyGroup>
    <LangVersion>12.0</LangVersion>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- Сборка библиотек и CI: общие метаданные для NuGet (dotnet pack при необходимости) -->
    <Version>4.0.0</Version>
    <Authors>Zahar A. Ponimash</Authors>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/AIFramework/AIFramework3Open</RepositoryUrl>
    <PackageProjectUrl>https://github.com/AIFramework/AIFramework3Open</PackageProjectUrl>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IsPackable>false</IsPackable>
    <!-- Статический анализ -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>
  <!-- StyleCop убран: .NET Analyzers + .editorconfig покрывают стандарт кода -->
  <!-- SDK-проекты под src: публикуемые пакеты (dotnet pack) -->
  <PropertyGroup Condition="'$(UsingMicrosoftNETSdk)' == 'true' AND $([MSBuild]::MakeRelative($(MSBuildThisFileDirectory), $(MSBuildProjectDirectory)).StartsWith('src'))">
    <IsPackable>true</IsPackable>
    <PackageId>$(AssemblyName)</PackageId>
    <Description>AIFramework 3.0 Open — $(MSBuildProjectName)</Description>
    <!-- XML-документация рядом с DLL: без неё пакет NuGet приходит без описаний, хотя в исходниках
         они есть. Пропущенные комментарии (CS1591) не шумят: .editorconfig понижает их до suggestion. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <!-- Описания, иконка и README пакетов -->
  <Import Project="$(MSBuildThisFileDirectory)build/NuGet.props" />
  <!-- Лёгкая сборка: правила в отдельном файле, их подключает и Tests/Directory.Build.props -->
  <Import Project="$(MSBuildThisFileDirectory)build/Light.props" />
</Project>
