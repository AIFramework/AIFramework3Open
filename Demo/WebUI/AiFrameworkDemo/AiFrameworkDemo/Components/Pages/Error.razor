@page "/Error"

<PageTitle>Ошибка — AIFramework Demo</PageTitle>

<div class="aif-error-page">
    <div class="aif-error-page-icon" aria-hidden="true">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor"
             stroke-width="1.5" stroke-linecap="round">
            <circle cx="12" cy="12" r="10"/>
            <line x1="12" y1="8" x2="12" y2="12"/>
            <line x1="12" y1="16" x2="12.01" y2="16"/>
        </svg>
    </div>
    <h1 class="aif-error-page-title">Произошла ошибка</h1>
    <p class="aif-error-page-msg">Что-то пошло не так. Попробуйте перезагрузить страницу.</p>
    <a href="/" class="aif-error-page-link">← На главную</a>
</div>
