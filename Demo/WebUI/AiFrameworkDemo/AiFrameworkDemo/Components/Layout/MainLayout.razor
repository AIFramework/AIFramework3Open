@inherits LayoutComponentBase

<HeadContent>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet" />
</HeadContent>

<div class="aif-app-root">
    <header class="aif-header">
        <div class="aif-header-inner">
            <NavLink class="aif-brand" href="/" Match="NavLinkMatch.All" aria-label="AIFramework 3.0 — на главную">
                <img class="aif-brand-logo"
                     src="ai3_0_logo.png"
                     alt="AIFramework 3.0 Open" />
                <span class="aif-brand-text">
                    <span class="aif-brand-prefix">AI</span>Framework
                </span>
                <span class="aif-version-badge">v3.0</span>
            </NavLink>

            <div class="aif-header-right">
                <NavLink class="aif-chip aif-chip--link" href="/browse" style="text-decoration:none;">
                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
                        <rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/>
                        <rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/>
                    </svg>
                    <span class="aif-nav-label">Библиотеки</span>
                </NavLink>
                <NavLink class="aif-chip aif-chip--link" href="/solver" style="text-decoration:none;">
                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
                        <path d="M4 7h16M4 12h10M4 17h13"/>
                        <path d="M18 15l3 3-3 3"/>
                    </svg>
                    <span class="aif-nav-label">Solver</span>
                </NavLink>
                <NavLink class="aif-chip aif-chip--link" href="/catalog" style="text-decoration:none;">
                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
                        <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
                    </svg>
                    <span class="aif-nav-label">Каталог</span>
                </NavLink>
                <span class="aif-stack-badge">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/>
                    </svg>
                    .NET 10 · SkiaSharp · Markdig · KaTeX
                </span>
                <button class="aif-theme-toggle"
                        onclick="aifTheme.toggle()"
                        title="Переключить тему"
                        aria-label="Переключить тему">
                    <svg class="aif-theme-icon aif-theme-icon--sun" width="15" height="15" viewBox="0 0 24 24"
                         fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                        <circle cx="12" cy="12" r="5"/>
                        <line x1="12" y1="1" x2="12" y2="3"/>
                        <line x1="12" y1="21" x2="12" y2="23"/>
                        <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
                        <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
                        <line x1="1" y1="12" x2="3" y2="12"/>
                        <line x1="21" y1="12" x2="23" y2="12"/>
                        <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
                        <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
                    </svg>
                    <svg class="aif-theme-icon aif-theme-icon--moon" width="15" height="15" viewBox="0 0 24 24"
                         fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
                    </svg>
                </button>
                <button class="aif-theme-toggle aif-theme-toggle--contrast"
                        onclick="aifTheme.toggleContrast()"
                        title="Переключить контраст"
                        aria-label="Переключить контраст">
                    <span class="aif-contrast-icon" aria-hidden="true">A</span>
                </button>
                <a class="aif-gh-btn" href="https://github.com/AIFramework/AIFramework3Open" target="_blank"
                   rel="noopener noreferrer" title="GitHub AIFramework3Open">
                    <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                        <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
                    </svg>
                    <span class="aif-nav-label">GitHub</span>
                </a>
            </div>
        </div>
    </header>

    <main class="aif-app-main">
        @Body
    </main>

    <footer class="aif-footer">
        <div class="aif-footer-inner">
            <span class="aif-footer-logo">AIFramework <span class="aif-footer-ver">3.0 Open</span></span>
            <span class="aif-footer-sep">·</span>
            <span class="aif-footer-tech">ClassicMath · Charts · ControlSystems · ComputerVision · DSP</span>
            <span class="aif-footer-sep">·</span>
            <span>Apache-2.0</span>
            <span class="aif-footer-sep">·</span>
            <a class="aif-footer-link" href="https://github.com/AIFramework/AIFramework3Open" target="_blank" rel="noopener noreferrer">GitHub</a>
        </div>
    </footer>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Произошла ошибка.
    <a href="." class="reload">Перезагрузить</a>
    <span class="dismiss">X</span>
</div>
