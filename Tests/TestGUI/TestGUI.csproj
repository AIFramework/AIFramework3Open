    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Properties\AssemblyInfo.cs" />
  </ItemGroup>
  <ItemGroup>
    <None Include="App.config" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\AI.ONNX\AI.ONNX.csproj" />
    <ProjectReference Include="..\..\src\AI.ComputerVision\AI.ComputerVision.csproj" />
    <ProjectReference Include="..\..\src\AI.Fuzzy\AI.Fuzzy.csproj" />
    <ProjectReference Include="..\..\src\AI.NeuralNetworks\AI.NeuralNetworks.csproj" />
  </ItemGroup>
</Project>
