<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>12.0</LangVersion>
    <RootNamespace>OnnxQ</RootNamespace>
    <AssemblyName>OnnxQ</AssemblyName>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.20.1" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="Properties\AssemblyInfo.cs" />
  </ItemGroup>
  <ItemGroup>
    <None Include="App.config" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\AI.ONNX\AI.ONNX.csproj" />
    <ProjectReference Include="..\..\src\AI.ComputerVision\AI.ComputerVision.csproj" />
    <ProjectReference Include="..\..\src\AI.Charts\AI.Charts.csproj" />
    <ProjectReference Include="..\..\src\AI.Charts.WinForms\AI.Charts.WinForms.csproj" />
    <ProjectReference Include="..\..\src\AI.Fuzzy\AI.Fuzzy.csproj" />
  </ItemGroup>
</Project>
